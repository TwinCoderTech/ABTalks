generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  streak          Int       @default(0)
  progressPercent Int       @default(0)
  
  accounts        Account[]
  sessions        Session[]
  submissions     Submission[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Program {
  id              String   @id @default(uuid())
  title           String
  currentDay      Int
  totalDays       Int
  progressPercent Int
  type            String
}

model Hackathon {
  id              String   @id @default(uuid())
  title           String
  description     String
  startsIn        String
  durationBadge   String
  typeBadge       String
  imageUrl        String
}

model JobProfile {
  id              String   @id @default(uuid())
  title           String
  category        String
  tags            String   
  iconType        String   
}

model Submission {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  programId       String
  githubUrl       String?
  linkedinUrl     String
  submittedAt     DateTime @default(now())
}
